Cmnd_Alias RAVUNA_AVITO_DIRS = /usr/bin/install -d -o photoapp -g photoapp -m 0755 /opt/ravuna-avito /opt/ravuna-avito/releases, /usr/bin/install -d -o photoapp -g photoapp -m 0700 /opt/ravuna-avito/data
Cmnd_Alias RAVUNA_AVITO_BACKUP = /usr/bin/install -o photoapp -g photoapp -m 0600 /etc/nginx/sites-available/ravuna.ru /opt/ravuna-avito/nginx-backups/previous/ravuna.ru, /usr/bin/install -o photoapp -g photoapp -m 0600 /etc/nginx/conf.d/ravuna-avito-rate.conf /opt/ravuna-avito/nginx-backups/previous/rate.conf, /usr/bin/install -o photoapp -g photoapp -m 0600 /etc/nginx/snippets/ravuna-avito-location.conf /opt/ravuna-avito/nginx-backups/previous/location.conf
Cmnd_Alias RAVUNA_AVITO_INSTALL = /usr/bin/install -o root -g root -m 0644 /opt/ravuna-avito/current/ops/ravuna-avito-responder.service /etc/systemd/system/ravuna-avito-responder.service, /usr/bin/install -o root -g root -m 0644 /opt/ravuna-avito/current/ops/nginx/ravuna-avito-rate.conf /etc/nginx/conf.d/ravuna-avito-rate.conf, /usr/bin/install -o root -g root -m 0644 /opt/ravuna-avito/current/ops/nginx/ravuna-avito-location.conf /etc/nginx/snippets/ravuna-avito-location.conf, /usr/bin/install -o root -g root -m 0644 /opt/ravuna-avito/current/site/nginx/ravuna.ru.conf /etc/nginx/sites-available/ravuna.ru
Cmnd_Alias RAVUNA_AVITO_RESTORE = /usr/bin/install -o root -g root -m 0644 /opt/ravuna-avito/nginx-backups/previous/ravuna.ru /etc/nginx/sites-available/ravuna.ru, /usr/bin/install -o root -g root -m 0644 /opt/ravuna-avito/nginx-backups/previous/rate.conf /etc/nginx/conf.d/ravuna-avito-rate.conf, /usr/bin/install -o root -g root -m 0644 /opt/ravuna-avito/nginx-backups/previous/location.conf /etc/nginx/snippets/ravuna-avito-location.conf, /usr/bin/rm -f /etc/nginx/conf.d/ravuna-avito-rate.conf, /usr/bin/rm -f /etc/nginx/snippets/ravuna-avito-location.conf
Cmnd_Alias RAVUNA_AVITO_SERVICES = /usr/bin/systemctl daemon-reload, /usr/bin/systemctl enable ravuna-avito-responder.service, /usr/bin/systemctl restart ravuna-avito-responder.service, /usr/bin/systemctl stop ravuna-avito-responder.service, /usr/bin/systemctl disable ravuna-avito-responder.service, /usr/bin/systemctl reload nginx.service, /usr/sbin/nginx -t
photoapp ALL=(root) NOPASSWD: RAVUNA_AVITO_DIRS, RAVUNA_AVITO_BACKUP, RAVUNA_AVITO_INSTALL, RAVUNA_AVITO_RESTORE, RAVUNA_AVITO_SERVICES
