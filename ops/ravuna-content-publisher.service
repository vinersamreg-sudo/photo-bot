[Unit]
Description=Ravuna approved Content Studio publisher
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/ravuna-content/.env
ConditionPathExists=/opt/ravuna-content/current/app/content_studio/cli.py

[Service]
Type=oneshot
User=photoapp
Group=photoapp
WorkingDirectory=/opt/ravuna-content/current
EnvironmentFile=/opt/ravuna-content/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ravuna-content/venv/bin/python -m app.content_studio.cli content auto-run --apply
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ravuna-content/data
ReadOnlyPaths=/opt/photo-bot/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ravuna-content-publisher
