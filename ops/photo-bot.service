[Unit]
Description=photo-bot MAX transport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=photoapp
Group=photoapp
WorkingDirectory=/opt/photo-bot
EnvironmentFile=/opt/photo-bot/.env
ExecStart=/opt/photo-bot/venv/bin/python -m app.main run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/photo-bot/data /opt/photo-bot/logs /opt/photo-bot/temp

[Install]
WantedBy=multi-user.target
