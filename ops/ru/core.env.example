# Provision an independent /opt/photo-bot with private data/logs/temp (0700),
# then install as a mode-0600 .env; never copy production secrets wholesale.
BASE_DIR=/opt/photo-bot
APP_ENV=staging
MAX_TRANSPORT_MODE=disabled
MAX_POLL_OBSERVE_ONLY=true
MAX_PUBLIC_ACCESS_ENABLED=false
MAX_BOT_TOKEN=
MAX_OWNER_USER_IDS=
MAX_WEBHOOK_PORT=8092
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_CA_BUNDLE=ops/certs/russian_trusted_root_ca_pem.crt
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
IMAGE_EDIT_QUALITY=medium
IMAGE_EDIT_SIZE=auto
IMAGE_EDIT_INPUT_FIDELITY=auto
IMAGE_EDIT_OUTPUT_FORMAT=png
IMAGE_DIRECT_PROMPT_ENABLED=true
OPENAI_RESPONSES_IMAGE_ENABLED=false
OPENAI_IMAGE_REQUESTS_ENABLED=false
AI_GATEWAY_URL=
AI_GATEWAY_CA=
AI_GATEWAY_CERT=
AI_GATEWAY_KEY=
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=robokassa
PAYMENT_WEBHOOK_ENABLED=false
PAYMENT_WEBHOOK_LISTENER_ENABLED=false
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8091
PAYMENT_WEBHOOK_PATH=/payments/robokassa/result
PAYMENT_REFUNDS_ENABLED=false
ROBOKASSA_MODE=sandbox
ROBOKASSA_PRODUCTION_APPROVED=false
RESULT_RETENTION_ENABLED=false
# Leave blank until reviewed public terms and MAX copy are live; never backdate.
RESULT_RETENTION_POLICY_EFFECTIVE_AT=
