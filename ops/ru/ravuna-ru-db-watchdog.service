[Unit]
Description=Independent Ravuna SQLite checkpoint freshness watchdog
After=network-online.target
Wants=network-online.target
OnFailure=ravuna-ru-recovery-fail@%n.service

[Service]
Type=oneshot
User=photoapp
Group=photoapp
WorkingDirectory=/opt/photo-bot
EnvironmentFile=/etc/ravuna/ru-recovery.env
Environment=AWS_CONFIG_FILE=/etc/ravuna/ru-s3-cli.conf
Environment=AWS_PAGER= AWS_EC2_METADATA_DISABLED=true
LoadCredential=s3.credentials:/etc/ravuna/credentials/s3-db-reader.credentials
StateDirectory=ravuna-ru-db-watchdog
StateDirectoryMode=0700
ExecStart=/usr/bin/env AWS_SHARED_CREDENTIALS_FILE=${CREDENTIALS_DIRECTORY}/s3.credentials /opt/photo-bot/venv/bin/python -m app.ru_db_recovery freshness --root /opt/photo-bot --scratch /var/lib/ravuna-ru-db-watchdog --endpoint ${RU_S3_ENDPOINT} --bucket ${RU_S3_BUCKET} --region ${RU_S3_REGION}
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitCORE=0
