OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Production demo default. Use low only for an explicit cheap draft/smoke.
IMAGE_EDIT_QUALITY=medium
IMAGE_EDIT_SIZE=1024x1024
# gpt-image-2 always uses high input fidelity; auto means omit the API field.
IMAGE_EDIT_INPUT_FIDELITY=auto
IMAGE_EDIT_OUTPUT_FORMAT=png
OPENAI_MAX_RETRIES=2
OPENAI_CONVERSATION_MEMORY_ENABLED=false
OPENAI_RESPONSES_IMAGE_ENABLED=false
OPENAI_CONVERSATION_RETENTION_ENABLED=false
OPENAI_RESPONSES_MODEL=gpt-5.4-mini
OPENAI_CONTEXT_RETENTION_DAYS=30
OPENAI_CONTEXT_DELETE_ON_GALLERY_DELETE=true
OPENAI_CONTEXT_DELETE_ON_USER_DELETE=true
OPENAI_CONTEXT_MAX_IDLE_DAYS=14
OPENAI_CONTEXT_MAX_DEPTH=8
APP_ENV=production
BASE_DIR=/opt/photo-bot
DEMO_MAX_SUCCESSFUL_GENERATIONS=5
DEMO_SESSION_TTL_MINUTES=60
DEMO_WATERMARK_TEXT=ОБРАЗЕЦ
DEMO_MAX_DIMENSION=1024
DEMO_OUTPUT_FORMAT=JPEG
DEMO_JPEG_QUALITY=82
DEMO_MIN_REQUEST_INTERVAL_SECONDS=15
DEMO_MAX_ATTEMPTS_PER_HOUR=10
DEMO_MAX_CONCURRENT_PER_USER=1
GLOBAL_MAX_CONCURRENT_GENERATIONS=2
DEMO_DAILY_COST_LIMIT_RUB=1000
DEMO_DAILY_GENERATION_LIMIT=100
# Консервативный budget reserve, не фактический счёт провайдера.
DEMO_ESTIMATED_COST_RUB_PER_GENERATION=10
MAX_SOURCE_FILE_SIZE_MB=15
MAX_PROMPT_LENGTH=1500
GENERATION_TIMEOUT_SECONDS=300
UNLOCK_ORIGINAL_PRICE_RUB=149
# Payments are deliberately fail-closed. A deploy always leaves these disabled
# until a separately approved sandbox or production rollout.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_CURRENCY=RUB
PAYMENT_ORDER_TTL_MINUTES=30
PAYMENT_WEBHOOK_ENABLED=false
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8091
PAYMENT_WEBHOOK_PATH=/payments/robokassa/result
PAYMENT_REFUNDS_ENABLED=false
ROBOKASSA_MODE=sandbox
ROBOKASSA_PRODUCTION_APPROVED=false
ROBOKASSA_COMMISSION_PERCENT=0
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
ROBOKASSA_HASH_ALGORITHM=sha256
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
ROBOKASSA_REFUND_URL=https://services.robokassa.ru/RefundService/Refund/Create
ROBOKASSA_REFUND_STATUS_URL=https://services.robokassa.ru/RefundService/Refund/GetState
PAYMENT_RESULT_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_FAIL_URL=
PAYMENT_RECEIPT_TAX=none
PAYMENT_RECEIPT_ITEM_NAME=Оригинал фотографии Pixora
DEMO_RETENTION_DAYS=30
PAID_RETENTION_DAYS=180
TRASH_RETENTION_DAYS=30
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_CA_BUNDLE=ops/certs/russian_trusted_root_ca_pem.crt
MAX_TRANSPORT_MODE=disabled
# Comma-separated MAX user IDs allowed to use the closed test. Keep in a secret.
MAX_OWNER_USER_IDS=
# Ordered closed-pilot allowlist. The active prefix is controlled separately.
MAX_PILOT_USER_IDS=
PILOT_USER_LIMIT=0
# Transport-only safety mode: consumes updates but never invokes user handlers.
MAX_POLL_OBSERVE_ONLY=true
MAX_POLL_TIMEOUT_SECONDS=20
MAX_POLL_RETRY_SECONDS=5
MAX_POLL_IDLE_SECONDS=1
MAX_POLL_MAX_STALE_SECONDS=90
MAX_MEDIA_HOST_SUFFIXES=.max.ru,.oneme.ru,.okcdn.ru

# Dormant experimental router. Pixora v1 keeps this false and uses only
# gpt-image-2 until a later, separately approved architecture decision.
PROCESSING_MODE_ROUTER_ENABLED=false
REAL_BACKGROUND_COMPOSITE_ENABLED=false
ALLOW_AI_BACKGROUND_FALLBACK=false
BACKGROUND_ASSET_CATALOG=assets/backgrounds/catalog.json
SEGMENTATION_BACKEND=disabled
SEGMENTATION_MODEL=u2net_human_seg
SEGMENTATION_MODEL_DIR=data/models/rembg
# Required when SEGMENTATION_BACKEND=rembg. Pin the audited ONNX file exactly.
SEGMENTATION_MODEL_SHA256=
SEGMENTATION_TIMEOUT_SECONDS=120
LOCAL_AI_FINISHING_ENABLED=false

# Encrypted SQLite backups and safe cleanup.
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=30
CLEANUP_TEMP_RETENTION_HOURS=24
CLEANUP_ORPHAN_GRACE_HOURS=24
DISK_MIN_FREE_MB=2048
