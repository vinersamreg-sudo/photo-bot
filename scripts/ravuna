#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PYTHON=${RAVUNA_PYTHON:-"$ROOT/venv/bin/python"}
if [ ! -x "$PYTHON" ]; then
  PYTHON=${RAVUNA_PYTHON:-python}
fi
if [ "${1:-}" = "provider" ]; then
  shift
  cd "$ROOT"
  exec "$PYTHON" -m app.provider_switch "$@" --root "$ROOT"
fi
if [ "${1:-}" = "avito" ]; then
  shift
  cd "$ROOT"
  exec "$PYTHON" -m app.avito_responder.cli "$@"
fi
if [ "${1:-}" = "feedback-report" ]; then
  shift
  cd "$ROOT"
  exec "$PYTHON" -B -m app.feedback_report "$@"
fi
if [ "${1:-}" = "recovery-prune" ]; then
  shift
  cd "$ROOT"
  exec "$PYTHON" -B -m app.recovery_retention "$@"
fi
if [ "${1:-}" = "recovery-import-proofs" ]; then
  shift
  cd "$ROOT"
  exec "$PYTHON" -B -m app.recovery_retention --import-legacy "$@"
fi
exec "$PYTHON" -m app.content_studio.cli "$@"
