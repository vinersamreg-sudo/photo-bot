#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PYTHON=${RAVUNA_PYTHON:-"$ROOT/venv/bin/python"}
if [ ! -x "$PYTHON" ]; then
  PYTHON=${RAVUNA_PYTHON:-python}
fi
if [ "${1:-}" = "provider" ]; then
  shift
  cd "$ROOT"
  exec "$PYTHON" -m app.provider_switch "$@" --root "$ROOT"
fi
if [ "${1:-}" = "commercial-audit" ]; then
  shift
  cd "$ROOT"
  exec "$PYTHON" -m scripts.commercial_intelligence "$@"
fi
exec "$PYTHON" -m app.content_studio.cli "$@"
